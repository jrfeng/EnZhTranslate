* text=auto

# Shell 脚本必须是 LF，否则在 Linux / macOS 上会报 `syntax error near unexpected token do\r`
*.sh text eol=lf

# Windows 批处理用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
